{
  "slug": "studyforge-pack",
  "name": "StudyForge Pack Builder",
  "version": "0.1.1",
  "executa_type": "tool",
  "description": "Builds grounded study packs from notes: concepts, flashcards, quiz items, plan, mastery and review scheduling.",
  "tool_id": "tool-dev-studyforge",
  "type": "python",
  "enabled": true,
  "distribution": {
    "active": "local",
    "profiles": {
      "local": {
        "type": "local"
      },
      "binary": {
        "type": "binary",
        "executable_name": "studyforge-executa",
        "supports_protocol": true,
        "binary_artifacts": {
          "linux-x86_64": {
            "path": "dist/studyforge-executa-{version}-linux-x86_64.tar.gz",
            "entrypoint": "studyforge-executa"
          },
          "windows-x86_64": {
            "path": "dist/studyforge-executa-{version}-windows-x86_64.tar.gz",
            "entrypoint": "studyforge-executa.exe",
            "format": "tar.gz"
          }
        }
      }
    }
  }
}
